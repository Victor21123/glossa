<UserControl x:Class="Glossa.App.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Настройки after the approved mockups: sections on the left, the chosen one on the right. Sections whose
         features are not built yet (Учёба, Игры и профили, Нагрузка на ПК) appear with their stages. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" Padding="12,22">
            <StackPanel x:Name="Nav" />
        </Border>
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="Host" Margin="40,30,40,40" Focusable="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
