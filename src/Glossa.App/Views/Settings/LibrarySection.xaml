<UserControl x:Class="Glossa.App.Views.Settings.LibrarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Glossa.App.Views">
    <!-- Настройки → Словарь и Anki (canvas «Настройки — словарь и Anki»). What is kept from the game and how words reach
         Anki; the Anki preview shows the fields the «Glossa Word v1» note really carries. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Словарь и Anki" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Что сохраняется из игры и как слова попадают в Anki." Style="{StaticResource SectionDescription}" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource SettingRows}">
                    <StackPanel>
                        <HeaderedContentControl Header="Сохранять найденные слова" Tag="в «Словарь»" Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoSaveWords}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Note}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Text="повторный поиск того же слова прибавляет счётчик и добавляет реплику, а не делает копию" />
                            </DockPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Кадры из игры" Tag="снимок сцены у каждого слова" Style="{StaticResource SettingRow}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="ShotsFolder" Style="{StaticResource PathBox}" MaxWidth="360" />
                                <TextBlock x:Name="ShotsSize" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Button Content="Открыть" Margin="14,0,0,0" Click="OnOpenShots" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,30,0,12">
                    <TextBlock Text="Anki" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <Ellipse x:Name="AnkiDot" Width="8" Height="8" StrokeThickness="1.5" Margin="14,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="AnkiState" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource SettingRows}">
                    <StackPanel>
                        <HeaderedContentControl Header="В карточке Anki" Style="{StaticResource SettingRowTop}">
                            <UniformGrid Columns="2" HorizontalAlignment="Left" Width="480" Margin="0,7,0,0">
                                <CheckBox Content="Кадр из игры" IsChecked="{Binding Settings.AnkiImages}" Margin="0,0,0,12" />
                                <CheckBox Content="Звук слова" IsChecked="{Binding Settings.AnkiAudio}" Margin="0,0,0,12" />
                                <CheckBox Content="Обратная карточка" IsChecked="{Binding Settings.AnkiReverse}" />
                            </UniformGrid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Колоды" Style="{StaticResource SettingRow}">
                            <TextBlock Style="{StaticResource Note}" FontSize="13.5"
                                       Text="Glossa::Английский, Glossa::Японский, Glossa::Китайский — по языку слова; тип заметки «Glossa Word v1»." />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Отправить в Anki" Tag="через AnkiConnect" Style="{StaticResource SettingRow}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Отправить сейчас" Click="OnSync" IsEnabled="{Binding Library.Busy, Converter={x:Static v:InverseBool.Instance}}" />
                                <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Text="нужна запущенная Anki с дополнением AnkiConnect (код 2055492159)" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Экспорт" Tag="всё или то, что отфильтровано в «Словаре»" Style="{StaticResource SettingRow}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Колода .apkg" Click="OnExportApkg" />
                                <Button Content="Quizlet" Click="OnExportQuizlet" Margin="8,0,0,0" />
                                <Button Content="CSV" Click="OnExportCsv" Margin="8,0,0,0" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Library.Status}" Style="{StaticResource Note}" FontSize="13.5" Margin="0,12,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                <StackPanel>
                    <TextBlock Text="КАРТОЧКА В ANKI" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Rule}" Background="{DynamicResource Page}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="ЛИЦО" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <Border x:Name="FaceShot" Height="150" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Band}" Margin="0,0,0,10"
                                    Visibility="{Binding Settings.AnkiImages, Converter={StaticResource BoolToVis}}">
                                <Canvas x:Name="FaceStage" ClipToBounds="True">
                                    <Image x:Name="FaceImage" Stretch="Fill" />
                                    <Rectangle x:Name="FaceRing" RadiusX="3" RadiusY="3" StrokeThickness="2" Stroke="{DynamicResource Accent}" />
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="FaceContext" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="FaceWord" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Visibility="{Binding Settings.AnkiAudio, Converter={StaticResource BoolToVis}}">
                                <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M11,5 L6,9 H3 V15 H6 L11,19 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5" Stroke="{DynamicResource Muted}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="звук слова" FontSize="13" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Rule}" Background="{DynamicResource Page}" Padding="14"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ОБОРОТ" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <TextBlock x:Name="BackTranslation" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="BackDefinition" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock x:Name="BackContext" FontSize="13.5" LineHeight="19" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock x:Name="BackMeta" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PreviewNote" Style="{StaticResource Note}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
