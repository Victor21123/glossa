<UserControl x:Class="Glossa.App.Views.Settings.SourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Glossa.App.Views"
             xmlns:theme="clr-namespace:Glossa.App.Theme">
    <!-- Настройки → Справочники (canvas: «справочники, установленные / каталог / импорт файла»). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <v:FalseToVisibleConverter x:Key="FalseToVis" />

        <!-- A selectable row: surface with a rule when selected, a band on hover. -->
        <Style x:Key="PickRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="14,6"
                                Margin="0,0,0,2" MinHeight="54">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Band}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rule}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Stat" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource StatLabel}" />
                            <ContentPresenter TextElement.FontSize="15" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EntryTemplate">
            <StackPanel Margin="0,0,0,10">
                <WrapPanel>
                    <TextBlock Text="{Binding Headword}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Reading}" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <v:MarkupView Markup="{Binding Body}" MaxLines="10" Margin="0,3,0,0" TextElement.FontSize="13.5" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <ListBox x:Name="Tabs" DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Bottom" SelectionChanged="OnTab">
                <ListBoxItem Content="Установленные" IsSelected="True" />
                <ListBoxItem Content="Каталог" />
                <ListBoxItem Content="Импорт файла" />
            </ListBox>
            <StackPanel>
                <TextBlock Text="Справочники" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SectionDescription}"
                           Text="Скачанные словари. Их статьи видны в карточке и у слова в твоём словаре, но сами в словарь не попадают." />
            </StackPanel>
        </DockPanel>

        <!-- ============ Установленные ============ -->
        <Grid x:Name="InstalledTab">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding InstalledSummary}" Style="{StaticResource Note}" />
                    <TextBlock Text="ПОРЯДОК В КАРТОЧКЕ" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" ItemContainerStyle="{StaticResource PickRow}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Number}" Width="26" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" BorderBrush="Transparent" Tag="M12,19 V5 M6,11 L12,5 L18,11" ToolTip="Выше в карточке" Click="OnUp" />
                                    <Button Style="{StaticResource IconButton}" BorderBrush="Transparent" Tag="M12,5 V19 M6,13 L12,19 L18,13" ToolTip="Ниже в карточке" Click="OnDown"
                                            Margin="2,0,14,0" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" ToolTip="Показывать в карточке" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Visibility="{Binding HasPacks, Converter={StaticResource FalseToVis}}"
                           Text="Словарей пока нет — они во вкладке «Каталог»." />
                <Border Style="{StaticResource SettingRows}" Margin="0,22,0,0">
                    <StackPanel>
                        <HeaderedContentControl Header="Статей на словарь в карточке" Tag="в пресете «Больше»; в «Стандарте» словари свёрнуты"
                                                Style="{StaticResource SettingRow}">
                            <ComboBox Width="110" HorizontalAlignment="Left" SelectedItem="{Binding EntriesPerDictionary}" x:Name="EntryCounts" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Подсказывать ИИ значения из справочников" Style="{StaticResource SettingRow}"
                                                Tag="смысл решает реплика; словарь помогает выбрать значение">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HintAi}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" Margin="0,12,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}" DataContext="{Binding Details}"
                    Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" FontSize="14" LineHeight="20" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap"
                               Margin="0,6,0,18" />
                    <UniformGrid Columns="3">
                        <HeaderedContentControl Header="СТАТЕЙ" Style="{StaticResource Stat}" Content="{Binding Entries}" />
                        <HeaderedContentControl Header="РАЗМЕР" Style="{StaticResource Stat}" Content="{Binding Size}" />
                        <HeaderedContentControl Header="ЯЗЫКИ" Style="{StaticResource Stat}" Content="{Binding Pair}" />
                        <HeaderedContentControl Header="ИСТОЧНИК" Style="{StaticResource Stat}" Content="{Binding Origin}" />
                        <HeaderedContentControl Header="СОБРАН" Style="{StaticResource Stat}" Content="{Binding Built}" />
                        <HeaderedContentControl Header="ЛИЦЕНЗИЯ" Style="{StaticResource Stat}">
                            <TextBlock Text="{Binding License, TargetNullValue=—}" TextWrapping="Wrap" FontSize="13" />
                        </HeaderedContentControl>
                    </UniformGrid>
                    <Border Height="1" Background="{DynamicResource Rule}" Margin="0,4,0,16" />
                    <TextBlock Text="ПРОВЕРИТЬ СЛОВО" Style="{StaticResource SectionCaption}" Margin="0,0,0,8" />
                    <TextBox x:Name="CheckBox" theme:Hint.Text="слово, как в словаре" TextChanged="OnCheck" />
                    <ItemsControl x:Name="CheckResults" ItemTemplate="{StaticResource EntryTemplate}" Margin="0,12,0,0" />
                    <TextBlock x:Name="CheckEmpty" Style="{StaticResource Note}" Visibility="Collapsed" Text="В этом словаре такого слова нет." />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Обновить" Click="OnUpdatePack" Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                        <Button Content="Удалить" Style="{StaticResource GhostButton}" Click="OnRemovePack" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Каталог ============ -->
        <Grid x:Name="CatalogTab" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBox DockPanel.Dock="Right" Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" theme:Hint.Text="Найти словарь" />
                    <ListBox Style="{StaticResource SegmentedSmall}" SelectedValuePath="Tag" SelectedValue="{Binding Filter}" VerticalAlignment="Center">
                        <ListBoxItem Content="Все" Tag="all" />
                        <ListBoxItem Content="Английский" Tag="en" />
                        <ListBoxItem Content="Японский" Tag="ja" />
                        <ListBoxItem Content="Китайский" Tag="zh" />
                        <ListBoxItem Content="Уровни" Tag="levels" />
                    </ListBox>
                </DockPanel>
                <ListBox ItemsSource="{Binding CatalogView}" SelectedItem="{Binding SelectedEntry}" ItemContainerStyle="{StaticResource PickRow}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="14,16,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Pair}" FontSize="13.5" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Download}" FontSize="13.5" Foreground="{DynamicResource InkSoft}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Grid Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl Content="{Binding InstalledText}" Style="{StaticResource OkText}" FontSize="13"
                                                    Visibility="{Binding ShowInstalled, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Установить" MinHeight="32" Height="32" Click="OnInstall"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Width="190" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource GhostButton}" MinHeight="0" Height="20" Padding="4,0"
                                                    FontSize="12.5" Click="OnCancel" />
                                            <TextBlock Text="{Binding Status}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <CheckBox Content="Хранить скачанные исходники — пересборка без новой загрузки" IsChecked="{Binding KeepSources}" Margin="14,18,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}" DataContext="{Binding SelectedEntry}"
                    Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" FontSize="14" LineHeight="20" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap"
                               Margin="0,6,0,18" />
                    <UniformGrid Columns="3">
                        <HeaderedContentControl Header="ЗАГРУЗКА" Style="{StaticResource Stat}" Content="{Binding Download}" />
                        <HeaderedContentControl Header="ЯЗЫКИ" Style="{StaticResource Stat}" Content="{Binding Pair}" />
                        <HeaderedContentControl Header="СОСТОЯНИЕ" Style="{StaticResource Stat}">
                            <TextBlock FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="не установлен" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Installed}" Value="True">
                                                <Setter Property="Text" Value="{Binding InstalledText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </HeaderedContentControl>
                    </UniformGrid>
                    <HeaderedContentControl Header="ЛИЦЕНЗИЯ" Style="{StaticResource Stat}">
                        <TextBlock Text="{Binding Item.License}" TextWrapping="Wrap" FontSize="13.5" />
                    </HeaderedContentControl>
                    <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,2,0,0">
                        <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnInstall" />
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                               Text="Загрузка идёт через системный прокси, при ошибке — напрямую. Словарь собирается в D:\GlossaData\dict\packs, скачанный исходник потом удаляется." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Импорт файла ============ -->
        <Grid x:Name="ImportTab" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid x:Name="DropZone" Height="210" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="Transparent">
                    <Border CornerRadius="12" Background="{DynamicResource Band}" />
                    <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource Rule}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,15 V4 M7,9 L12,4 L17,9 M4,15 V20 H20 V15" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Перетащи файл словаря сюда" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,10" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="или" FontSize="13.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="Выбрать файл…" MinHeight="32" Height="32" Click="OnChooseFile" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Text="DSL (ABBYY Lingvo) · StarDict · MDX (MDict) · Yomitan · zip с ними" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,22,0,0" Padding="22,18" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                        BorderThickness="1" DataContext="{Binding Draft}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Убрать" Style="{StaticResource GhostButton}" MinHeight="32" Height="32" Click="OnDiscard" />
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,3 H14 L18,7 V21 H6 Z M14,3 V7 H18" Stroke="{DynamicResource Ink}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SizeText}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Формат" FontSize="13.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <ContentControl Grid.Column="1" Content="{Binding Format}" Style="{StaticResource OkText}" />
                            <TextBlock Grid.Row="1" Text="Название" FontSize="13.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360"
                                     HorizontalAlignment="Left" Width="360" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="Языки" FontSize="13.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="80" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" theme:Hint.Text="en" />
                                <TextBlock Text="→" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0" />
                                <TextBox Width="80" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" theme:Hint.Text="ru" />
                                <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           Text="угадано по заголовку файла; en, ja, zh, ru" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Собрать словарь" Style="{StaticResource PrimaryButton}" Click="OnBuild" />
                            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="14,0,0,0" Text="около минуты; исходный файл не меняется" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource GhostButton}" Click="OnCancel"
                            Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource Note}" FontSize="13.5" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Text="ИМПОРТИРОВАНО РАНЕЕ" Style="{StaticResource SectionCaption}" Margin="0,20,0,8" />
                <ItemsControl ItemsSource="{Binding Imported}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource RuleSoft}" BorderThickness="0,1,0,0" Padding="0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Note}" FontSize="13.5" Visibility="{Binding HasImported, Converter={StaticResource FalseToVis}}"
                           Text="Пока ничего. Собранные словари появятся во вкладке «Установленные» рядом со скачанными." />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                <StackPanel>
                    <TextBlock Text="ПОДХОДЯЩИЕ ФОРМАТЫ" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
                    <StackPanel x:Name="Formats" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,14,0,0"
                               Text="Файл не уходит в интернет. Язык статей Glossa угадывает по заголовку; если ошиблась — поправь перед сборкой." />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
