<UserControl x:Class="Glossa.App.Views.Settings.AppSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:Glossa.App.ViewModels">
    <!-- Настройки → Приложение (canvas «Настройки — приложение»). Scale, moving the data folder and backups are not
         built yet and are left out. -->
    <StackPanel>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Приложение" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Тема, запуск, данные и журнал." Style="{StaticResource SectionDescription}" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SettingRows}" VerticalAlignment="Top">
                <StackPanel>
                    <HeaderedContentControl Header="Тема окна" Tag="у карточки слова может быть своя" Style="{StaticResource SettingRow}">
                        <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding Theme}">
                            <ListBoxItem Content="Как в Windows" Tag="system" />
                            <ListBoxItem Content="Тёмная" Tag="dark" />
                            <ListBoxItem Content="Светлая" Tag="light" />
                            <ListBoxItem Content="Диско" Tag="disco" />
                        </ListBox>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Запуск" Style="{StaticResource SettingRow}">
                        <CheckBox Content="Запускать вместе с Windows - сразу в трей" IsChecked="{Binding StartWithWindows}" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Header='Кнопка "Закрыть"' Style="{StaticResource SettingRow}">
                        <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding CloseToTray}">
                            <ListBoxItem Content="Сворачивает в трей">
                                <ListBoxItem.Tag><sys:Boolean>True</sys:Boolean></ListBoxItem.Tag>
                            </ListBoxItem>
                            <ListBoxItem Content="Выходит из Glossa">
                                <ListBoxItem.Tag><sys:Boolean>False</sys:Boolean></ListBoxItem.Tag>
                            </ListBoxItem>
                        </ListBox>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Статистика на главной" Tag="серия дней, календарь, языки" Style="{StaticResource SettingRow}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HomeStats}" />
                    </HeaderedContentControl>

                    <!-- One series for every mode (decided 2026-09-30): any action keeps the day, a full one is darker. -->
                    <HeaderedContentControl Header="Полный день" Tag="для серии дней" Style="{StaticResource SettingRow}">
                        <!-- A grid, not a horizontal stack: the note takes the rest of the row and wraps instead of running off its edge. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:SettingsViewModel.DayGoals}}" SelectedItem="{Binding DayGoal}"
                                      Width="90" MinHeight="34" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="действий: поиск слова, ответ в учёбе или перевод реплики. Меньше - день всё равно держит серию, но светлее в календаре" />
                        </Grid>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Папка данных" Tag="словарь, кадры, справочники" Style="{StaticResource SettingRow}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="DataFolder" Style="{StaticResource PathBox}" MaxWidth="460" />
                            <Button Content="Открыть" Margin="10,0,0,0" Click="OnOpenData" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Сеть" Style="{StaticResource SettingRow}">
                        <TextBlock Style="{StaticResource Note}" FontSize="13.5"
                                   Text="Словари скачиваются через системный прокси, при ошибке - напрямую. Кроме загрузок словарей, проверки обновлений на GitHub и своего API, если оно подключено, Glossa в интернет не ходит." />
                    </HeaderedContentControl>

                    <!-- Decided 2026-10-01: Glossa only tells that a newer version is out; nothing is downloaded or installed. -->
                    <HeaderedContentControl x:Name="UpdateSwitchRow" Header="Проверять обновления" Tag="раз в сутки" Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource Note}" FontSize="13.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Раз в сутки Glossa спрашивает у GitHub номер последней версии. GitHub при этом видит IP-адрес и версию Glossa, больше ничего не отправляется и не скачивается." />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl x:Name="UpdateCheckRow" Header="Новая версия" Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckNow" Content="Проверить сейчас" Click="OnCheckNow" />
                                <Button x:Name="OpenRelease" Content="Открыть страницу" Margin="10,0,0,0" Click="OnOpenRelease" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Note}" FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Журнал" Tag="для разбора ошибок" Style="{StaticResource SettingRow}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Сохранять кадры распознавания" IsChecked="{Binding DebugOcrDumps}" VerticalAlignment="Center" />
                            <Button Content="Открыть журнал" Margin="20,0,0,0" Click="OnOpenLog" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                <StackPanel>
                    <TextBlock Text="НА ДИСКЕ" Style="{StaticResource SectionCaption}" />
                    <TextBlock x:Name="DiskTotal" Text="считаю..." FontSize="28" FontWeight="Bold" Margin="0,10,0,12" />
                    <Grid x:Name="DiskBar" Height="14" ClipToBounds="True" />
                    <ItemsControl x:Name="DiskLegend" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="30">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Ink}" Opacity="{Binding Opacity}"
                                            VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DiskNote" Style="{StaticResource Note}" Margin="0,8,0,0" />
                    <Border Height="1" Background="{DynamicResource Rule}" Margin="0,18" />
                    <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource SectionCaption}" />
                    <TextBlock x:Name="Version" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock x:Name="Build" Style="{StaticResource Note}" />
                    <TextBlock Text="для личного использования" Style="{StaticResource Note}" Margin="0,4,0,0" />
                    <TextBlock x:Name="Location" Style="{StaticResource Note}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
