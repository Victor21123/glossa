<UserControl x:Class="Glossa.App.Views.Settings.KeysSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Настройки → Вызов и клавиши (canvas «Настройки — вызов и клавиши»). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Вызов и клавиши" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Как позвать Glossa из игры и чем управлять карточкой." Style="{StaticResource SectionDescription}" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MaxWidth="1060" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SettingRows}" VerticalAlignment="Top">
                <StackPanel>
                    <!-- What the keys do: the word card, or only a translation (three ways, «Зона» by default). -->
                    <HeaderedContentControl Header="Режим" Tag="что делает сочетание" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding Purpose}" HorizontalAlignment="Left">
                                <ListBoxItem Content="Словарь и учёба" Tag="dictionary" />
                                <ListBoxItem Content="Только перевод" Tag="translate" />
                            </ListBox>
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding PurposeNote}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Как переводить" Tag='в режиме "Только перевод"' Style="{StaticResource SettingRowTop}"
                                            Visibility="{Binding IsTranslatePurpose, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding TranslateMode}" HorizontalAlignment="Left">
                                <ListBoxItem Content="Зона" Tag="zone" />
                                <ListBoxItem Content="Весь экран" Tag="screen" />
                                <ListBoxItem Content="Живой перевод" Tag="live" />
                            </ListBox>
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding TranslateModeNote}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Поиск слова" Tag="главное сочетание" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="HotkeyCaps" Focusable="False" VerticalAlignment="Center" />
                                <Button x:Name="ChangeButton" Content="Изменить" Margin="14,0,0,0" Click="OnChange" />
                                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnCancel"
                                        Visibility="Collapsed" />
                            </StackPanel>
                            <ContentControl x:Name="HotkeyResult" Margin="0,10,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="HotkeyNote" Style="{StaticResource Note}" Margin="0,10,0,0"
                                       Text="Сочетание, занятое другой программой, Glossa не примет и скажет об этом." />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Открыть Glossa" Tag="окно словаря поверх всего" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="WindowCaps" Focusable="False" VerticalAlignment="Center" />
                                <Button x:Name="WindowChangeButton" Content="Изменить" Margin="14,0,0,0" Click="OnChangeWindow" />
                                <Button x:Name="WindowOffButton" Content="Убрать" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnWindowOff" />
                                <Button x:Name="WindowCancelButton" Content="Отмена" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnCancel"
                                        Visibility="Collapsed" />
                            </StackPanel>
                            <ContentControl x:Name="WindowResult" Margin="0,10,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Кнопка мыши" Tag="ищет слово под курсором" Style="{StaticResource SettingRow}">
                        <StackPanel Orientation="Horizontal">
                            <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding MouseButton}">
                                <ListBoxItem Content="Нет" Tag="none" />
                                <ListBoxItem Content="Кнопка 4" Tag="x1" />
                                <ListBoxItem Content="Кнопка 5" Tag="x2" />
                            </ListBox>
                            <TextBlock Style="{StaticResource Note}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       Text='удобно, когда рука на мыши; кнопка 5 ("вперёд") в играх обычно свободна' />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Геймпад" Tag="сочетание кнопок" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="PadCaps" Focusable="False" VerticalAlignment="Center" />
                                <Button x:Name="PadRecordButton" Content="Записать" Margin="14,0,0,0" Click="OnRecordPad" />
                                <Button x:Name="PadOffButton" Content="Убрать" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnPadOff" />
                            </StackPanel>
                            <ContentControl x:Name="PadResult" Margin="0,10,0,0" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Например, LB + RB. Открывает стоп-кадр с выделенным первым словом реплики: крестовина или стик - другое слово, A - искать, B - назад, X - сохранить, Y - произнести. Xbox-геймпады, DualSense, DualShock 4 и Switch Pro." />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Во время поиска" Tag="что происходит с игрой" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <ListBox Style="{StaticResource Segmented}" SelectedValuePath="Tag" SelectedValue="{Binding DuringLookup}"
                                     HorizontalAlignment="Left">
                                <ListBoxItem Content="Не трогать" Tag="none" />
                                <ListBoxItem Content="Остановить кадр" Tag="frame" />
                                <ListBoxItem Content="Пауза игры" Tag="pause" />
                            </ListBox>
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text='Остановить кадр: карточка на снимке экрана, игра идёт дальше; щёлкни другое слово на снимке. Пауза игры: процесс игры замирает, пока открыта карточка, - для игр на время. В играх с античитом вместо паузы - стоп-кадр. Игра проснётся сама, если что-то пойдёт не так: через 5 минут или по Ctrl+Alt+R. Для отдельной игры - в "Играх и профилях".' />
                            <DockPanel Margin="0,14,0,0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MarkKnownWords}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Style="{StaticResource Note}" Margin="14,0,0,0" TextWrapping="Wrap"
                                           Text='Отмечать на стоп-кадре слова из словаря: тонкой пунктирной рамкой, а "Не могу запомнить" - жирной янтарной.' />
                            </DockPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Клавиши в карточке" Tag="пока карточка открыта" Style="{StaticResource SettingRowTop}">
                        <StackPanel>
                            <UniformGrid x:Name="CardKeys" Columns="2" Margin="0,-4,0,0" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                       Text='Пробел работает только в режиме "Перевод по клику" (Карточка слова). Пока карточки нет, эти клавиши остаются игре.' />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                <StackPanel>
                    <TextBlock Text="ПРОВЕРКА" Style="{StaticResource SectionCaption}" />
                    <TextBlock x:Name="CheckTitle" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Note}" FontSize="13.5" Text="Здесь видно, что услышала Glossa и чем закончился поиск." />
                    <StackPanel x:Name="Log" Margin="0,12,0,0" />
                    <TextBlock x:Name="LogEmpty" Style="{StaticResource Note}" Margin="0,4,0,0" Text="Поисков пока не было." />
                    <Border Height="1" Background="{DynamicResource Rule}" Margin="0,16" />
                    <TextBlock Text="СОЧЕТАНИЯ" Style="{StaticResource SectionCaption}" Margin="0,0,0,10" />
                    <ContentControl x:Name="HotkeyState" />
                    <ContentControl x:Name="WindowHotkeyState" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
