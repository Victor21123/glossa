<Window x:Class="Glossa.App.Views.FrozenFrame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Background="Black" Title="Glossa — стоп-кадр"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <!-- «Остановить кадр»: the screen as it was at the key press, over the game, until the user goes back to it.
         Words are chosen on it with the mouse (a click) or the gamepad (the highlight). -->
    <Grid>
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <!-- Words already in the dictionary: a thin dashed frame; «Не могу запомнить»: a bold amber one. Under the highlight. -->
        <Canvas x:Name="Known" IsHitTestVisible="False" />
        <Canvas x:Name="Marks" IsHitTestVisible="False">
            <!-- Over a game, not over Glossa: white with a dark halo reads on any scene, whatever the window theme. -->
            <Border x:Name="Highlight" Visibility="Collapsed" BorderThickness="3" CornerRadius="5" BorderBrush="White">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                </Border.Effect>
            </Border>
        </Canvas>
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Padding="16,9"
                CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="СТОП-КАДР" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="HintText" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                <TextBlock x:Name="KnownText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
