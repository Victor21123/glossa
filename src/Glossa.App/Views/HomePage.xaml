<UserControl x:Class="Glossa.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Glossa.App.Views">
    <!-- «Главная»: where the window opens. The dictionary (or, in «Только перевод», how to call the translation) beside the
         AI's state, the numbers, and the lookup map with the companion's place to its right (it comes with study).
         No settings here: the essentials are set on first launch, the rest in Настройки. Fills any window width. -->
    <UserControl.Resources>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource SidePanel}">
            <Setter Property="Padding" Value="20,16,20,18" />
        </Style>

        <!-- «Модель   Gemma 4 26B»: a muted name, the value after it. -->
        <Style x:Key="InfoName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="16,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40">
            <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Today" Style="{StaticResource SectionDescription}" />

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- The dictionary: how big, the newest words (a click opens one), the way in. -->
                <Border x:Name="WordsPanel" Style="{StaticResource SidePanel}" VerticalAlignment="Stretch">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Открыть словарь" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"
                                Click="OnOpenWords" />
                        <StackPanel>
                            <TextBlock Text="Словарь" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="WordsTotal" Style="{StaticResource Figure}" Margin="0,6,0,0" />
                            <TextBlock x:Name="WordsNote" Style="{StaticResource Note}" Margin="0,4,0,0" />
                            <WrapPanel x:Name="Recent" Margin="0,16,0,-8" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- «Только перевод»: the dictionary and study are hidden, so the page says how to call the translation. -->
                <Border x:Name="TranslatePanel" Style="{StaticResource SidePanel}" VerticalAlignment="Stretch" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Сменить режим" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                Margin="0,-6,-12,0" Tag="keys" Click="OnOpenSettings" />
                        <StackPanel>
                            <TextBlock Text="Только перевод" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="TranslateCall" Style="{StaticResource Figure}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" MaxWidth="720" HorizontalAlignment="Left"
                                       Text="{Binding TranslateModeNote}" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0" MaxWidth="720" HorizontalAlignment="Left"
                                       Text='Слова не сохраняются и учёбы нет; переведённые реплики - в "Словаре" -> "Цитаты". Вернуть слова и учёбу - "Сменить режим" -> "Словарь и учёба".' />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The AI as it is now; changed in Настройки → ИИ. -->
                <Border Grid.Column="2" Style="{StaticResource SidePanel}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Настройки ИИ" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                    Margin="0,-6,-12,0" Tag="ai" Click="OnOpenSettings" />
                            <TextBlock Text="ИИ" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="AiDot" Width="10" Height="10" StrokeThickness="1.5" Margin="0,2,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiState" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentControl x:Name="AiMissing" Style="{StaticResource WarnText}" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed" />
                        <!-- "Загрузить в фон" / "Выгрузить" (2026-10-03): the model ready before Alt+Q; loaded by hand it stays through idle. -->
                        <Button x:Name="AiLoad" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnAiLoad" Visibility="Collapsed" />
                        <Grid Margin="0,16,0,-8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Модель" Style="{StaticResource InfoName}" />
                            <TextBlock x:Name="AiModel" Grid.Column="1" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="1" Text="Режим" Style="{StaticResource InfoName}" />
                            <TextBlock x:Name="AiMode" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="2" Text="Движок" Style="{StaticResource InfoName}" />
                            <TextBlock x:Name="AiEngine" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="3" Text="Видеопамять" Style="{StaticResource InfoName}" />
                            <TextBlock x:Name="AiVram" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- «Учёба»: today's session and the days in a row (hidden in «Только перевод»). -->
            <Border x:Name="StudyPanel" Style="{StaticResource SidePanel}" Margin="0,20,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="StudyButton" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                            Click="OnOpenStudy" />
                    <StackPanel>
                        <TextBlock Text="Учёба" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="StudyTotal" Style="{StaticResource Figure}" Margin="0,6,0,0" />
                        <TextBlock x:Name="StudyNote" Style="{StaticResource Note}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Статистика (Приложение → «Статистика на главной»): four tiles across the page. -->
            <StackPanel x:Name="Stats" Margin="0,30,0,0">
                <TextBlock Text="Статистика" FontSize="18" FontWeight="Bold" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /><ColumnDefinition Width="20" />
                        <ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <!-- One series for every mode (decided 2026-09-30): lookups, study answers and translations all count. -->
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="ДНЕЙ ПОДРЯД С GLOSSA" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="Streak" Style="{StaticResource Figure}" />
                            <TextBlock x:Name="StreakNote" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="ЛУЧШАЯ СЕРИЯ" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="Best" Style="{StaticResource Figure}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Name="ThirdLabel" Text="ПОИСКОВ ВСЕГО" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="Lookups" Style="{StaticResource Figure}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Name="FourthLabel" Text="НЕ МОГУ ЗАПОМНИТЬ" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="Pinned" Style="{StaticResource Figure}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- The lookup map and the languages; the companion to the right. A wide window gives the map more weeks (up to a
                 year), not the companion an empty middle (the user, 2026-10-03). -->
            <Grid x:Name="Lower" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeatPanel" Style="{StaticResource SidePanel}" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock x:Name="HeatCaption" Text="ДНИ С GLOSSA, ПОЛГОДА" Style="{StaticResource SectionCaption}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="пн" FontSize="11.5" Foreground="{DynamicResource Muted}" Height="20" Margin="0,0,0,20" />
                                <TextBlock Text="ср" FontSize="11.5" Foreground="{DynamicResource Muted}" Height="20" Margin="0,0,0,20" />
                                <TextBlock Text="пт" FontSize="11.5" Foreground="{DynamicResource Muted}" Height="20" Margin="0,0,0,20" />
                                <TextBlock Text="вс" FontSize="11.5" Foreground="{DynamicResource Muted}" Height="20" />
                            </StackPanel>
                            <UniformGrid x:Name="Heat" Rows="7" Columns="26" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="32,10,0,0">
                            <TextBlock Text="меньше" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                            <StackPanel x:Name="Legend" Orientation="Horizontal" />
                            <TextBlock Text="больше" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="HeatNote" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="32,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" />
                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,20" />
                        <TextBlock Text="ЯЗЫКИ" Style="{StaticResource SectionCaption}" Margin="0,0,0,12" />
                        <StackPanel x:Name="Languages" Margin="0,0,0,-10" />
                    </StackPanel>
                </Border>

                <!-- The companion (2026-10-03): the character in full height on the floor of the card, who it is, how it feels
                     and why, the days together. Shown in every mode and with the statistics off: the series feeds it. -->
                <Border x:Name="CompanionPanel" Grid.Column="1" Style="{StaticResource SidePanel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="СПУТНИК" Style="{StaticResource SectionCaption}" Margin="0,0,0,12" />
                        <Grid>
                        <DockPanel>
                        <!-- The character in full height on the left (it asks for the room of a 2x scale and for the bubble's
                             room over its head); beside it, the admin menu while it is open. -->
                        <v:CompanionSprite x:Name="Sprite" DockPanel.Dock="Left" Margin="12,0,36,0" Cursor="Hand"
                                           HeadRoom="{x:Static v:SpeechBubble.Room}" Beside="200" />
                        <Grid>
                            <!-- Who and how, in the card's top right corner (the user marked the place, 2026-10-03). -->
                            <StackPanel x:Name="CompanionInfo" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="440">
                                <TextBlock x:Name="CompanionName" FontSize="24" TextWrapping="Wrap" TextAlignment="Right"
                                           TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" />
                                <TextBlock x:Name="CompanionWho" Style="{StaticResource Note}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0" />
                                <TextBlock x:Name="CompanionMood" FontSize="14" TextWrapping="Wrap" TextAlignment="Right" Margin="0,10,0,0" />
                                <TextBlock x:Name="CompanionDays" Style="{StaticResource Note}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="440" Margin="0,0,0,8">
                            <!-- The admin menu: opened for the session by the secret word typed on this page
                                 (HomePage.AdminOn); the mood here is a preview, nothing saved. -->
                            <StackPanel x:Name="CompanionDev" Visibility="Collapsed">
                                <TextBlock Text="АДМИН-МЕНЮ" Style="{StaticResource SectionCaption}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DevCompanion" />
                                    <ComboBox x:Name="DevMood" Grid.Column="2" SelectionChanged="OnDevMood" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Взять" Click="OnDevPick" Margin="0,0,8,0" />
                                    <Button Content="Бросок" Click="OnDevRoll" Margin="0,0,8,0" />
                                    <Button Content="Закрыть" Click="OnDevClose" />
                                </StackPanel>
                                <TextBlock x:Name="DevLog" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                        </DockPanel>
                        <!-- The speech bubble (the user's sketch, 2026-10-03): over the head, its tail down to it, reaching
                             right over the free top of the words' column. Placed by HomePage.PlaceBubble; clicks go through
                             to the companion. -->
                        <Canvas x:Name="BubbleLayer" IsHitTestVisible="False" UseLayoutRounding="True">
                            <v:SpeechBubble x:Name="Bubble" Visibility="Collapsed" />
                        </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
