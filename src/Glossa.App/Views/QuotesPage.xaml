<UserControl x:Class="Glossa.App.Views.QuotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Glossa.App.Views"
             xmlns:vm="clr-namespace:Glossa.App.ViewModels"
             xmlns:theme="clr-namespace:Glossa.App.Theme"
             SizeChanged="OnSized">
    <!-- «Словарь» → «Цитаты» (decided 2026-09-30): the lines translated in «Только перевод», laid out as the words are.
         The catalogue buttons and icons are the main window's (DynamicResource: they resolve once the page is in it). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <v:FalseToVisibleConverter x:Key="FalseToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="540" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" Padding="12,18,12,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" Margin="10,0,6,10" TextWrapping="Wrap"
                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                    <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="OnExportCsv">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{DynamicResource IconExport}" Stroke="{DynamicResource InkSoft}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Выгрузить в CSV..." Foreground="{DynamicResource InkSoft}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
                <!-- «Слова / Цитаты»: hidden in «Только перевод», where «Словарь» holds only quotes. -->
                <ListBox x:Name="ModeSwitch" DockPanel.Dock="Top" Style="{StaticResource Segmented}" Margin="0,0,0,22" SelectedIndex="1"
                         SelectionChanged="OnModeSwitch">
                    <ListBoxItem Content="Слова" />
                    <ListBoxItem Content="Цитаты" />
                </ListBox>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sidebar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuoteScopeGroup}">
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="10,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:QuoteScope}">
                                                <Button Style="{DynamicResource SidebarButton}" Click="OnScope" Tag="{Binding}" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Quote list -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="18,16,18,12">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,11,8"
                                     theme:Hint.Text="Реплика, перевод или игра" />
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{DynamicResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <!-- Several chosen: what can be done to all of them at once. -->
                <Border x:Name="BulkBar" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="18,10"
                        Background="{DynamicResource Band}" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Убрать кадры" Click="OnClearFrames" Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Удалить" Click="OnDelete" />
                        </StackPanel>
                        <TextBlock x:Name="BulkText" FontSize="13.5" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid>
                    <ListBox x:Name="QuotesList" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                             Padding="10,4,6,10" VirtualizingPanel.IsVirtualizingWhenGrouping="True" KeyDown="OnListKeyDown"
                             SelectionChanged="OnListSelection" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Caption}" Margin="10,12,0,6">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuoteEntry}">
                                <Grid Margin="10,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LanguageCode}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" FontFamily="{Binding TextFont}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                        <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                            <Run Text="{Binding Translation, Mode=OneWay}" Foreground="{DynamicResource InkSoft}" /><Run
                                                Text="{Binding Game, Mode=OneWay, StringFormat=' - {0}'}" Foreground="{DynamicResource Faint}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyList" Style="{StaticResource Note}" Margin="28,24" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text='Цитат пока нет. В режиме "Только перевод" сюда попадает каждая переведённая реплика и зона, а в живом переводе - субтитр по Alt+S.' />
                </Grid>
            </DockPanel>
        </Border>

        <!-- The quote -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                      Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <StackPanel Margin="28,22,28,24">
                <Border x:Name="FrameBox" Height="420" CornerRadius="10" Background="#FF1C1A18" ClipToBounds="True">
                    <Grid>
                        <!-- The frame (1280 px) and the ring around the line, scaled together. -->
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="FrameGrid">
                                <Image x:Name="FrameImage" Stretch="None" />
                                <Canvas x:Name="FrameOverlay" IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="NoFrame" Text="Кадра нет" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Surface}" CornerRadius="7" Height="30" Padding="12,0" Margin="14"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding SeenText}" FontSize="13" Foreground="{DynamicResource InkSoft}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Text}" FontFamily="{Binding TextFont}" FontSize="24" FontWeight="SemiBold" LineHeight="34" TextWrapping="Wrap"
                           Margin="0,24,0,0" />
                <TextBlock Text="{Binding Translation}" FontSize="18" LineHeight="27" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource InkSoft}" />
                <TextBlock Text="{Binding Details}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" />

                <DockPanel Margin="0,22,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Удалить" Click="OnDelete" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Tag="{DynamicResource IconSpeaker}" Click="OnSpeak" ToolTip="Произнести" Margin="0,0,8,0" />
                        <Button Content="Копировать" Click="OnCopy" Padding="12,0" Margin="0,0,8,0" ToolTip="Реплику и перевод - в буфер обмена" />
                        <Button Content="Убрать кадр" Click="OnClearFrames" Padding="12,0"
                                Visibility="{Binding HasShot, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
