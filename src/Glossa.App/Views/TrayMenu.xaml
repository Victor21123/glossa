<Window x:Class="Glossa.App.Views.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Left="-10000" Top="-10000"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- The tray menu after the approved mockup «Меню в трее»: state of the AI, the window, the AI mode, pausing the
         lookup hotkey, settings, exit. Drawn with the window palette, so it follows the window theme. -->
    <Window.Resources>
        <Style x:Key="TrayItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="36" Padding="10,0" CornerRadius="7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Well}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Well}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="34" Padding="10,0" CornerRadius="7" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Ink}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Well}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Rule}" />
        </Style>

        <DropShadowEffect x:Key="Lift" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="1" Color="{DynamicResource ShadowColor}" />
    </Window.Resources>

    <Border x:Name="Panel" Margin="18,14,18,24" Width="320" Padding="6" CornerRadius="12" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Rule}" BorderThickness="1" Effect="{StaticResource Lift}">
        <StackPanel>
            <StackPanel Margin="10,8,10,6">
                <TextBlock Text="Glossa" FontSize="15" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" StrokeThickness="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StateText" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource Sep}" />
            <Button x:Name="OpenItem" Style="{StaticResource TrayItem}" Content="Открыть словарь" Click="OnOpen" />
            <Border Style="{StaticResource Sep}" />
            <TextBlock Text="РЕЖИМ ИИ" Style="{StaticResource Caption}" Margin="10,6,10,4" />
            <RadioButton x:Name="ModeAuto" Style="{StaticResource TrayChoice}" Content="Авто" GroupName="TrayMode" Tag="auto" Click="OnMode" />
            <RadioButton x:Name="ModeLow" Style="{StaticResource TrayChoice}" Content="Минимум видеопамяти" GroupName="TrayMode" Tag="lowvram" Click="OnMode" />
            <RadioButton x:Name="ModeOff" Style="{StaticResource TrayChoice}" Content="Выключен" GroupName="TrayMode" Tag="off" Click="OnMode" />
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource TrayItem}" Click="OnToggleLookup">
                <DockPanel>
                    <CheckBox x:Name="LookupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsHitTestVisible="False" Focusable="False" />
                    <TextBlock x:Name="LookupText" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Style="{StaticResource TrayItem}" Content="Настройки" Click="OnSettings" />
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource TrayItem}" Content="Выход" Click="OnExit" />
        </StackPanel>
    </Border>
</Window>
