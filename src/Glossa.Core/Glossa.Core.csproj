<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glossa.Tests" />
  </ItemGroup>

  <!-- The release's companion keys, only where the author's secrets folder is (see Directory.Build.props). -->
  <ItemGroup Condition="Exists('$(GlossaSecrets)CompanionSecrets.g.cs')">
    <Compile Include="$(GlossaSecrets)CompanionSecrets.g.cs" Link="Companions\CompanionSecrets.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

</Project>
